{
  "name": "eventify-backend",
  "version": "1.0.0",
  "description": "Backend for Event Marketplace App",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prestart": "npm run build",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "nodejs",
    "typescript",
    "express",
    "prisma",
    "event-marketplace"
  ],
  "author": "Tesfu",
  "license": "Apache",
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "nodemailer": "^8.0.1",
    "uuid": "^13.0.0",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.0",
    "@types/nodemailer": "^7.0.9",
    "@types/uuid": "^10.0.0",
    "prisma": "^6.3.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
